# =====================================================================
# SignalMesh AI Backend - Environment Configuration Template
# Copy this file to '.env' and populate with your credentials.
# NEVER commit the actual '.env' file to version control.
# =====================================================================

# Server Configuration
PORT=5000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# ---------------------------------------------------------------------
# Snowflake Connection Parameters
# ---------------------------------------------------------------------
# Account identifier format:
#   Format: <organization_name>-<account_name>  (e.g., xy12345.us-east-1 or myorg-myaccount)
SNOWFLAKE_ACCOUNT=your_snowflake_account_identifier

# Authentication (Username + Password)
SNOWFLAKE_USERNAME=your_snowflake_username
SNOWFLAKE_PASSWORD=your_snowflake_password

# Optional: Authenticator type (defaults to 'SNOWFLAKE', supports 'EXTERNALBROWSER', 'KEYPAIR')
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE

# Target Database, Schema, and Compute Warehouse
SNOWFLAKE_DATABASE=SIGNALMESH_DB
SNOWFLAKE_SCHEMA=MONITORING
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Snowflake Role:
# For initial hackathon setup, ACCOUNTADMIN was confirmed.
# For production and least-privilege compliance, create and use a dedicated
# application role (e.g., SIGNALMESH_APP_ROLE) granted only SELECT/INSERT on
# SIGNALMESH_DB.MONITORING.* and USAGE on COMPUTE_WH.
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Client Options
SNOWFLAKE_CLIENT_SESSION_KEEP_ALIVE=true
SNOWFLAKE_TIMEOUT_MS=15000

# ---------------------------------------------------------------------
# SMS Alert & Phone Verification Provider (Twilio)
# ---------------------------------------------------------------------
# Obtain Account SID & Auth Token from Twilio Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# E.164 phone number purchased/assigned in your Twilio account
# Required for Twilio Programmable SMS
TWILIO_PHONE_NUMBER=+1234567890

# Optional: Twilio Verify Service SID (starts with 'VA...')
# If configured, uses Twilio Verify API for managed OTP delivery & validation
TWILIO_VERIFY_SERVICE_SID=

# Security & Session Token Secret
SESSION_SECRET=your_random_32_character_secret_key_here

# When Twilio credentials are not yet configured or testing in development,
# setting this to 'true' enables a safe Developer Sandboxing mode where
# OTPs and SMS payloads are logged in backend console with exact E.164 normalization,
# allowing end-to-end verification without claiming fake provider delivery.
DEV_OTP_CONSOLE_ECHO=false
